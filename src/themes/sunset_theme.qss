/* AYEC Sunset Theme */
QMainWindow, QDialog { background-color: #1A0A14; color: #FFE4D6; }
QLabel { color: #FFE4D6; }
QPushButton { background-color: #FF6B35; color: #1A0A14; border: 1px solid #E55A28; border-radius: 10px; padding: 7px 12px; font-weight: 600; }
QPushButton:hover { background-color: #E55A28; }
QPushButton:pressed { background-color: #CC4A1A; }
QPushButton:disabled { background-color: #2E1820; color: #7A5060; border-color: #5C2E3C; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox { background-color: #241018; color: #FFE4D6; border: 1px solid #5C2E3C; border-radius: 10px; padding: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid #FF6B35; }
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled { background-color: #200E18; color: #7A5060; }
QComboBox:hover { background-color: #2E1820; color: #FFE4D6; border: 1px solid #FF6B35; }
QComboBox QAbstractItemView { background-color: #241018; color: #FFE4D6; border: 1px solid #5C2E3C; selection-background-color: #7C2D3C; selection-color: #FFE4D6; outline: none; }
QComboBox QAbstractItemView::item:hover { background-color: #2E1820; color: #FFE4D6; }
QComboBox QAbstractItemView::item:selected { background-color: #7C2D3C; color: #FFE4D6; }
QTableWidget, QTreeWidget, QListWidget { background-color: #241018; alternate-background-color: #2E1820; color: #FFE4D6; border: 1px solid #5C2E3C; gridline-color: #2E1820; }
QTableWidget::item, QTreeWidget::item, QListWidget::item { color: #FFE4D6; padding: 6px 8px; }
QTableWidget::item:alternate, QTreeWidget::item:alternate, QListWidget::item:alternate { background-color: #2E1820; color: #FFE4D6; }
QTableWidget::item:hover, QTreeWidget::item:hover, QListWidget::item:hover { background-color: #3A1E2A; color: #FFE4D6; }
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected { background-color: #7C2D3C; color: #FFE4D6; }
QTableWidget::item:selected:hover, QTreeWidget::item:selected:hover, QListWidget::item:selected:hover { background-color: #8F3448; color: #FFE4D6; }
QHeaderView::section { background-color: #2E1820; color: #D4A0A0; border: 1px solid #5C2E3C; padding: 6px; }
QHeaderView::section:hover { background-color: #241018; color: #FFE4D6; }
QGroupBox { background-color: #1A0A14; color: #FFE4D6; border: 1px solid #5C2E3C; border-radius: 10px; margin-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #FF9A7A; }
QTabWidget::pane { border: 1px solid #5C2E3C; background: #1A0A14; border-radius: 8px; }
QTabBar::tab { background: #241018; color: #D4A0A0; border: 1px solid #5C2E3C; padding: 7px 12px; border-radius: 10px; margin-right: 4px; }
QTabBar::tab:selected { background: #2E1820; color: #FFE4D6; border-color: #FF6B35; }
QTabBar::tab:hover { background: #2E1820; color: #FFE4D6; }
QMenuBar, QStatusBar { background-color: #241018; color: #FFE4D6; border-top: 1px solid #5C2E3C; }
QMenu { background-color: #241018; color: #FFE4D6; border: 1px solid #5C2E3C; }
QMenu::item:selected { background-color: #7C2D3C; color: #FFE4D6; }
QScrollBar:vertical, QScrollBar:horizontal { background: #200E18; border: 1px solid #5C2E3C; border-radius: 4px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #5C2E3C; border-radius: 4px; min-height: 20px; min-width: 20px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #FF6B35; }
#SideMenu, QWidget#SideMenu { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #1A0A14, stop:0.4 #241018, stop:1 #1A0A14); color: #FFE4D6; border-right: 1px solid #5C2E3C; }
#SideMenu QPushButton:hover { background-color: rgba(255,107,53,0.12); }
#SideMenu QPushButton[active="true"] { background-color: #FF6B35; color: #1A0A14; }
