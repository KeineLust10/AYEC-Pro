{
  "expo": {
    "name": "AYEC Pro Teknik Servis",
    "slug": "ayec-pro-teknik-servis",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayecpro.sahatakip"
    },
    "android": {
      "package": "com.ayecpro.teknikservis",
      "versionCode": 2,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": ["android.permission.READ_PHONE_STATE"]
    },
    "plugins": [
      "expo-secure-store",
      ["expo-camera", {"cameraPermission": "Allow AYEC Pro to scan device codes and capture service photos."}],
      ["expo-image-picker", {"cameraPermission": "Allow AYEC Pro to capture service evidence photos."}]
    ]
  }
}
