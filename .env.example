ENABLE_MEMORY_EVOLUTION=0
ENABLE_MEMORY_REWRITE=0
MEMORY_REWRITE_MIN_SUCCESS=4
MEMORY_REWRITE_MAX_FAIL_RATIO=0.50
MEMORY_REWRITE_MIN_CONFIDENCE=0.75
METRICS_ROTATE_MAX_BYTES=2097152
METRICS_ROTATE_MAX_ARCHIVES=10

GITHUB_TOKEN=
GITHUB_REPO=
