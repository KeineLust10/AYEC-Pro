# Run a separate copy of Web_Arayuzu/Main.py for this demo host.
AYEC_HOST=127.0.0.1
AYEC_PORT=8502
AYEC_COOKIE_SECURE=1
AYEC_DEMO_MODE=1
AYEC_DEMO_LANDING_ORIGIN=https://demo.ayecpro.com
AYEC_DEMO_APP_HOST=demo-panel.ayecpro.com
AYEC_PUBLIC_URL=https://demo.ayecpro.com
AYEC_SERVICE_TRACKING_URL=https://demo.ayecpro.com/servis/takip
AYEC_VENDOR_NAME=AYEC Pro Demo
AYEC_VENDOR_PHONE=0000000000
AYEC_LICENSE_BANK=Demo Bank
AYEC_LICENSE_HOLDER=AYEC Pro Demo
AYEC_LICENSE_IBAN=TR000000000000000000000000

# Keep every writable database, upload, log, and backup under this sandbox root.
AYEC_DEMO_ROOT=/srv/ayecpro-demo/data
AYEC_DB_PATH=/srv/ayecpro-demo/data/registry.db
AYEC_TENANT_DIR=/srv/ayecpro-demo/data/tenants
AYEC_DEMO_TEMPLATE=/srv/ayecpro-demo/data/demo_template.db
AYEC_BACKUP_DIR=/srv/ayecpro-demo/data/backups
AYEC_SUPPORT_BACKUP_DIR=/srv/ayecpro-demo/data/support-backups
AYEC_PROGRAM_BACKUP_ROOT=/srv/ayecpro-demo/data/program-backups
AYEC_DOWNLOADS_DIR=/srv/ayecpro-demo/data/downloads
