Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "no-store, max-age=0"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; form-action 'self' https://demo-panel.ayecpro.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>

<FilesMatch "^(\.env|.*\.db|.*\.sqlite|.*\.log|.*\.py)$">
  Require all denied
</FilesMatch>
