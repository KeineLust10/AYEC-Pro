# Dışarı açılan port
AYEC_PORT=8501

# Docker ve normal kurulumda varsayılan tam EasyOCR zinciridir.
# Hafif kurulum için requirements.txt, Paddle için requirements-paddle.txt yazın.
AYEC_REQUIREMENTS=requirements-ocr.txt

# Docker kullanmadan çalıştırırken örnekler:
# AYEC_HOST=0.0.0.0
# AYEC_DB_PATH=data/ayecpro.db
# Her firmanın ayrı SQLite dosyalarının tutulacağı klasör.
# AYEC_TENANT_DIR=Kullanıcılar
# TESSERACT_CMD=/usr/bin/tesseract
